+  m_binlog_file = existing.release();
+  mysql_mutex_unlock(&LOCK_sync);
+  name = restored_name.release();
+  db[0] = 0;
+  m_log_file_key = m_key_file_log;
+  write_error = false;
+  max_size = max_size_arg;
+  bytes_written = 0;
+  m_dependency_tracker.rotate();
+  atomic_log_state = LOG_OPENED;
+  update_binlog_end_pos();
+  return false;
+}
