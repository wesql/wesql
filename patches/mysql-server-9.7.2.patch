 /* Namespace for all clone data types */
 namespace myclone {
+#ifdef WESQL
+using Local_clone_observer_callback = int (*)(
+    THD *, uint64_t, const unsigned char *, unsigned int, void *);
+
+/** Select the unique live InnoDB locator and invoke one observer phase. */
+inline int invoke_local_clone_observer(
+    THD *thd, const Storage_Vector &storage,
+    const Mysql_clone_local_observer *observer,
+    Local_clone_observer_callback callback) {
+  if (observer == nullptr) return 0;
+  if (observer->request_id == 0 || observer->bind == nullptr ||
+      observer->complete == nullptr || callback == nullptr)
+    return ER_INTERNAL_ERROR;
+
+  const Locator *innodb = nullptr;
+  for (const Locator &locator : storage) {
+    if (locator.m_hton == nullptr ||
+        locator.m_hton->db_type != DB_TYPE_INNODB)
+      continue;
+    if (innodb != nullptr) return ER_INTERNAL_ERROR;
+    innodb = &locator;
+  }
+  if (innodb == nullptr || innodb->m_loc == nullptr ||
+      innodb->m_loc_len == 0)
+    return ER_INTERNAL_ERROR;
+  return callback(thd, observer->request_id, innodb->m_loc, innodb->m_loc_len,
+                  observer->context);
+}
+
+/** Bind the request to the source clone immediately after clone begin. */
+inline int bind_local_clone_observer(
+    THD *thd, const Storage_Vector &storage,
+    const Mysql_clone_local_observer *observer) {
+  return invoke_local_clone_observer(
+      thd, storage, observer, observer == nullptr ? nullptr : observer->bind);
+}
+
+/** Complete the request after successful copy and apply-end. */
+inline int complete_local_clone_observer(
+    THD *thd, const Storage_Vector &storage,
+    const Mysql_clone_local_observer *observer) {
+  return invoke_local_clone_observer(
+      thd, storage, observer,
+      observer == nullptr ? nullptr : observer->complete);
+}
+#endif
