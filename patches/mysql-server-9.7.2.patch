+           "remote startup supplied an invalid existing-binlog boundary");
+    return true;
+  }
+
+  auto [files, index_error] = get_filename_list();
+  if (index_error.is_error() || files.empty() ||
+      fs::path(files.back()).filename().string() != expected_file) {
+    LogErr(ERROR_LEVEL, ER_LOG_PRINTF_MSG,
+           "remote startup binlog does not equal the terminal index entry");
+    return true;
+  }
+
+  const fs::path terminal = files.back();
+  std::error_code filesystem_error;
+  const uintmax_t observed_size = fs::file_size(terminal, filesystem_error);
+  if (filesystem_error || observed_size != static_cast<uintmax_t>(expected_pos)) {
+    LogErr(ERROR_LEVEL, ER_LOG_PRINTF_MSG,
+           "remote startup binlog size does not equal the authenticated "
+           "cursor");
+    return true;
+  }
+
+  auto existing = Binlog_ofile::open_existing(
+      m_key_file_log, terminal.c_str(), MYF(MY_WME | MY_NABP | MY_WAIT_IF_FULL));
+  uchar in_use = LOG_EVENT_BINLOG_IN_USE_F;
+  if (existing == nullptr || existing->is_encrypted() ||
+      existing->update(&in_use, 1, BIN_LOG_HEADER_SIZE + FLAGS_OFFSET) ||
+      existing->flush_and_sync()) {
+    LogErr(ERROR_LEVEL, ER_LOG_PRINTF_MSG,
+           "remote startup cannot mark the authenticated binlog active");
+    return true;
+  }
+
+  if (existing->seek_existing(expected_pos) ||
+      existing->position() != expected_pos) {
+    LogErr(ERROR_LEVEL, ER_LOG_PRINTF_MSG,
+           "remote startup cannot reopen the authenticated binlog cursor");
+    return true;
+  }
+
+  std::unique_ptr<char, decltype(&my_free)> restored_name(
+      my_strdup(key_memory_MYSQL_LOG_name, log_name, MYF(MY_WME)), &my_free);
+  if (!restored_name ||
+      init_and_set_log_file_name(log_name, terminal.c_str(), 0))
+    return true;
