+bool xa::recovery::enumerate_prepared_transactions_in_engine(
+    handlerton *ht, Prepared_xid_inventory *inventory) {
+  if (ht == nullptr || inventory == nullptr || ht->recover == nullptr)
+    return true;
+  if (::reject_nonzero_heuristic_recovery("before an engine recover callback"))
+    return true;
+
+  uint batch_size = REMOTE_XID_MAX_BATCH_SIZE;
+  std::unique_ptr<XA_recover_txn[]> batch;
+  while (batch == nullptr) {
+    batch.reset(new (std::nothrow) XA_recover_txn[batch_size]);
+    if (batch != nullptr || batch_size == REMOTE_XID_MIN_BATCH_SIZE) break;
+    batch_size /= 2;
+  }
+  if (batch == nullptr) {
+    LogErr(ERROR_LEVEL, ER_SERVER_OUTOFMEMORY,
+           static_cast<int>(batch_size * sizeof(XA_recover_txn)));
+    return true;
+  }
+
+  MEM_ROOT mem_root{PSI_INSTRUMENT_ME, TABLE_ALLOC_BLOCK_SIZE};
+  int recovered = 0;
+  do {
+    if (::reject_nonzero_heuristic_recovery(
+            "before an engine recover callback"))
+      return true;
+
+    recovered = ht->recover(ht, batch.get(), batch_size, &mem_root);
+
+    if (::reject_nonzero_heuristic_recovery(
+            "after an engine recover callback"))
+      return true;
+    if (recovered < 0 || static_cast<uint>(recovered) > batch_size) {
+      LogErr(ERROR_LEVEL, ER_LOG_PRINTF_MSG,
+             "Prepared-transaction inventory received an invalid recover() "
+             "result");
+      return true;
+    }
+
+    for (int i = 0; i < recovered; ++i) {
+      if (batch[i].id.get_my_xid() == 0)
+        ++inventory->external_entries;
+      else
+        ++inventory->internal_entries;
+    }
+    mem_root.ClearForReuse();
+  } while (static_cast<uint>(recovered) == batch_size);
