diff --git a/CMakeLists.txt b/CMakeLists.txt
index 86a1e2b8..474e158c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -523 +523,12 @@ SET(CMAKE_CXX_STANDARD 23)
+OPTION(WITH_WESQL "Build WeSQL extensions" ON)
+OPTION(WITH_WESQL_TEST "Enable WeSQL-only test hooks" OFF)
+IF(WITH_WESQL)
+  ADD_COMPILE_DEFINITIONS(WESQL)
+  IF(WITH_WESQL_TEST)
+    ADD_COMPILE_DEFINITIONS(WESQL_TEST)
+  ENDIF()
+ELSEIF(WITH_WESQL_TEST)
+  MESSAGE(FATAL_ERROR "WITH_WESQL_TEST requires WITH_WESQL")
+ENDIF()
+
 # Various 3rd party libraries have this option.
