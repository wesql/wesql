+  assert(lock_count == 0);
+  lock_count = 1;
+  if (mi->get_mi_description_event() == nullptr) {
+    LogErr(ERROR_LEVEL, ER_RPL_REPLICA_QUEUE_EVENT_FAILED_INVALID_CONFIGURATION,
+           mi->get_channel());
